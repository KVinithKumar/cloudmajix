# Copy this file to .env.local and fill in your values.
# Find them in Supabase: Project Settings -> API.
# Never commit .env.local. Add the same values in Vercel -> Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Lead email notifications (server-only; never prefix with NEXT_PUBLIC_).
# Sends each new contact-form lead through the Porkbun mailbox. Only SMTP_PASS is required;
# the others default to the values shown. Leave SMTP_PASS empty to turn emails off.
SMTP_PASS=
# SMTP_USER=support@cloudmajix.ca
# LEAD_NOTIFY_TO=support@cloudmajix.ca
# SMTP_HOST=smtp.porkbun.com
# SMTP_PORT=465
